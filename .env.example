# =====================================
# DJENEBA - Variables d'Environnement
# =====================================

# ----------------
# Base de données
# ----------------
# MongoDB Connection String
# Atlas (cloud): mongodb+srv://user:password@cluster.mongodb.net/djeneba?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/djeneba
MONGODB_URI=

# ----------------
# NextAuth.js
# ----------------
# URL de l'application
# Développement: http://localhost:3000
# Production: https://votre-domaine.com
NEXTAUTH_URL=http://localhost:3000

# Secret pour NextAuth (générer avec: openssl rand -base64 32)
NEXTAUTH_SECRET=

# ----------------
# Upload d'Images
# ----------------
# Option 1: Cloudinary (Recommandé)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option 2: AWS S3 (Alternative)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_REGION=eu-west-1
